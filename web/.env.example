# Copy to web/.env for local development. Never commit web/.env.
#
# Nuxt reads NUXT_-prefixed variables into runtimeConfig automatically:
#   NUXT_API_BASE          -> runtimeConfig.apiBase
#   NUXT_REVALIDATE_SECRET -> runtimeConfig.revalidateSecret
#   NUXT_PUBLIC_SITE_URL   -> runtimeConfig.public.siteUrl

# MUST match REVALIDATE_SECRET in api/.env. The two processes share this secret;
# if they disagree, publishing silently stops purging the cache and editors see
# stale pages with no error anywhere.
NUXT_REVALIDATE_SECRET=dev-only-change-me

# Where server-side rendering reaches Express. The browser always uses the
# relative /api path instead — see web/app/composables/useApi.ts.
NUXT_API_BASE=http://127.0.0.1:4100/api

NUXT_PUBLIC_SITE_URL=http://localhost:3100
