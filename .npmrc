# This project resolves from the public npm registry.
#
# The machine-level registry (npm.egcextremeunrealtechnology.com, set in
# ~/.npmrc) returns 502 for drizzle-orm and drizzle-kit while serving other
# packages normally. This override is scoped to this repo only — global config
# and every other project are untouched.
#
# Remove this file once the mirror serves those packages again.
registry=https://registry.npmjs.org/
