{
  "name": "cherished-moments-school",
  "private": true,
  "version": "0.1.0",
  "description": "Cherished Moments School — public website and admin CMS",
  "type": "module",
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=api && npm run build --workspace=web",
    "migrate": "npm run migrate --workspace=api",
    "migrate:generate": "npm run migrate:generate --workspace=api",
    "seed": "npm run seed --workspace=api",
    "db:reset": "npm run db:reset --workspace=api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "create-admin": "npm run create-admin --workspace=api",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
