{
  "name": "@cms/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/src/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:generate": "drizzle-kit generate",
    "seed": "tsx src/db/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('data/school.db',{force:true})\" && npm run migrate && npm run seed",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "create-admin": "tsx src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@cms/shared": "*",
    "@node-rs/argon2": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.2.0",
    "pino": "^9.6.0",
    "sharp": "^0.35.4",
    "ulid": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
