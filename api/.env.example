# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=4100
HOST=127.0.0.1
LOG_LEVEL=debug

# SQLite file. Local disk only — never a network mount (docs/architecture.md §6).
DATABASE_PATH=./data/school.db

# Public origin of the site. Used in emails and canonical URLs.
PUBLIC_ORIGIN=http://localhost:3100

# Shared secret for the Nuxt cache-purge hook (docs/release-1.md §6).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=dev-only-change-me
REVALIDATE_URL=http://localhost:3100/__revalidate

# Signing key for session tokens and preview links. Same generator as above.
SECRET_KEY=dev-only-change-me

# --- Mail -------------------------------------------------------------------
# MAIL_TRANSPORT=file writes .eml files to data/mail/ and never touches the
# network. Nobody should need live SMTP credentials to work on this app.
MAIL_TRANSPORT=file
MAIL_FROM_NAME=Cherished Moments School
MAIL_FROM_ADDRESS=noreply@example.com

# Only read when MAIL_TRANSPORT=smtp. Free Gmail: app password, 2FA required,
# ~500 recipients/day — the outbox worker throttles against that cap.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
